<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.miribar.auth.mapper.StaffMapper">
    <select id="selectById" resultType="com.miribar.common.entity.Staff">
        SELECT * FROM t_staff WHERE id = #{id}
    </select>
    <select id="selectByUsername" resultType="com.miribar.common.entity.Staff">
        SELECT * FROM t_staff WHERE username = #{username}
    </select>
    <select id="selectByPhone" resultType="com.miribar.common.entity.Staff">
        SELECT * FROM t_staff WHERE phone = #{phone} LIMIT 1
    </select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_staff (store_id, username, password, phone, real_name, role, status)
        VALUES (#{storeId}, #{username}, #{password}, #{phone}, #{realName}, #{role}, #{status})
    </insert>
    <update id="update">
        UPDATE t_staff
        <set>
            <if test="password != null">password = #{password},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="realName != null">real_name = #{realName},</if>
            <if test="role != null">role = #{role},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id}
    </update>
</mapper>
