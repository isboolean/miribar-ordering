<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.miribar.ordering.mapper.StaffMapper">

    <select id="selectById" resultType="Staff">
        SELECT * FROM t_staff WHERE id = #{id}
    </select>

    <select id="selectByUsername" resultType="Staff">
        SELECT * FROM t_staff WHERE username = #{username}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_staff (store_id, username, password, real_name, role, status)
        VALUES (#{storeId}, #{username}, #{password}, #{realName}, #{role}, #{status})
    </insert>

    <update id="update">
        UPDATE t_staff
        <set>
            <if test="password != null">password = #{password},</if>
            <if test="realName != null">real_name = #{realName},</if>
            <if test="role != null">role = #{role},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id}
    </update>

</mapper>
