<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.miribar.ordering.mapper.OrderMapper">

    <resultMap id="orderResultMap" type="Order">
        <id property="id" column="id"/>
        <result property="storeId" column="store_id"/>
        <result property="tableId" column="table_id"/>
        <result property="customerId" column="customer_id"/>
        <result property="orderNo" column="order_no"/>
        <result property="status" column="status"/>
        <result property="paymentMethod" column="payment_method"/>
        <result property="paymentStatus" column="payment_status"/>
        <result property="totalAmount" column="total_amount"/>
        <result property="remark" column="remark"/>
        <result property="source" column="source"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="selectById" resultMap="orderResultMap">
        SELECT * FROM t_order WHERE id = #{id}
    </select>

    <select id="selectByOrderNo" resultMap="orderResultMap">
        SELECT * FROM t_order WHERE order_no = #{orderNo}
    </select>

    <select id="selectByTableId" resultMap="orderResultMap">
        SELECT * FROM t_order WHERE table_id = #{tableId} ORDER BY created_at DESC
    </select>

    <select id="selectByStoreIdAndStatus" resultMap="orderResultMap">
        SELECT * FROM t_order WHERE store_id = #{storeId} AND status = #{status} ORDER BY created_at ASC
    </select>

    <select id="selectActiveByStoreId" resultMap="orderResultMap">
        SELECT * FROM t_order WHERE store_id = #{storeId} AND status IN (0, 1, 2) ORDER BY created_at ASC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_order (store_id, table_id, customer_id, order_no, status, payment_method, payment_status, total_amount, remark, source)
        VALUES (#{storeId}, #{tableId}, #{customerId}, #{orderNo}, #{status}, #{paymentMethod}, #{paymentStatus}, #{totalAmount}, #{remark}, #{source})
    </insert>

    <update id="updateStatus">
        UPDATE t_order SET status = #{status} WHERE id = #{id}
    </update>

    <update id="updatePaymentStatus">
        UPDATE t_order SET payment_status = #{paymentStatus} WHERE id = #{id}
    </update>

</mapper>
