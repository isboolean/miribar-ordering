<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.miribar.ordering.mapper.DictDataMapper">
    
    <resultMap id="DictDataResult" type="com.miribar.ordering.entity.DictData">
        <id property="id" column="id"/>
        <result property="dictType" column="dict_type"/>
        <result property="dictLabel" column="dict_label"/>
        <result property="dictValue" column="dict_value"/>
        <result property="cssClass" column="css_class"/>
        <result property="listClass" column="list_class"/>
        <result property="isDefault" column="is_default"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="status" column="status"/>
        <result property="remark" column="remark"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>
    
    <select id="selectAll" resultMap="DictDataResult">
        SELECT * FROM t_dict_data ORDER BY sort_order, id
    </select>
    
    <select id="selectByDictType" resultMap="DictDataResult">
        SELECT * FROM t_dict_data WHERE dict_type = #{dictType} ORDER BY sort_order, id
    </select>
    
    <select id="selectByStatus" resultMap="DictDataResult">
        SELECT * FROM t_dict_data WHERE status = #{status} ORDER BY sort_order, id
    </select>
    
    <select id="selectById" resultMap="DictDataResult">
        SELECT * FROM t_dict_data WHERE id = #{id}
    </select>
    
    <select id="selectDefaultByDictType" resultMap="DictDataResult">
        SELECT * FROM t_dict_data 
        WHERE dict_type = #{dictType} AND is_default = 1 
        ORDER BY sort_order, id 
        LIMIT 1
    </select>
    
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_dict_data (dict_type, dict_label, dict_value, css_class, list_class, is_default, sort_order, status, remark)
        VALUES (#{dictType}, #{dictLabel}, #{dictValue}, #{cssClass}, #{listClass}, #{isDefault}, #{sortOrder}, #{status}, #{remark})
    </insert>
    
    <update id="update">
        UPDATE t_dict_data
        <set>
            <if test="dictLabel != null">dict_label = #{dictLabel},</if>
            <if test="dictValue != null">dict_value = #{dictValue},</if>
            <if test="cssClass != null">css_class = #{cssClass},</if>
            <if test="listClass != null">list_class = #{listClass},</if>
            <if test="isDefault != null">is_default = #{isDefault},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
        </set>
        WHERE id = #{id}
    </update>
    
    <delete id="deleteById">
        DELETE FROM t_dict_data WHERE id = #{id}
    </delete>
    
    <delete id="deleteByDictType">
        DELETE FROM t_dict_data WHERE dict_type = #{dictType}
    </delete>
    
    <select id="selectByKeyword" resultMap="DictDataResult">
        SELECT * FROM t_dict_data 
        WHERE dict_label LIKE CONCAT('%', #{keyword}, '%')
           OR dict_value LIKE CONCAT('%', #{keyword}, '%')
           OR remark LIKE CONCAT('%', #{keyword}, '%')
        ORDER BY sort_order, id
    </select>

    <!-- 字典数据列表公共条件，分页查询与总数统计复用 -->
    <sql id="dictDataConditions">
        <where>
            <if test="dictType != null and dictType != ''">
                AND dict_type = #{dictType}
            </if>
            <if test="dictLabel != null and dictLabel != ''">
                AND dict_label LIKE CONCAT('%', #{dictLabel}, '%')
            </if>
            <if test="dictValue != null and dictValue != ''">
                AND dict_value LIKE CONCAT('%', #{dictValue}, '%')
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
    </sql>

    <select id="selectPage" resultMap="DictDataResult">
        SELECT * FROM t_dict_data
        <include refid="dictDataConditions"/>
        ORDER BY sort_order, id
        LIMIT #{pageSize} OFFSET #{offset}
    </select>

    <select id="countByCondition" resultType="long">
        SELECT COUNT(1) FROM t_dict_data
        <include refid="dictDataConditions"/>
    </select>
    
</mapper>
