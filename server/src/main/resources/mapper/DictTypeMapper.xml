<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.miribar.ordering.mapper.DictTypeMapper">
    
    <resultMap id="DictTypeResult" type="com.miribar.ordering.entity.DictType">
        <id property="id" column="id"/>
        <result property="dictName" column="dict_name"/>
        <result property="dictType" column="dict_type"/>
        <result property="remark" column="remark"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>
    
    <select id="selectAll" resultMap="DictTypeResult">
        SELECT * FROM t_dict_type ORDER BY id
    </select>
    
    <select id="selectByStatus" resultMap="DictTypeResult">
        SELECT * FROM t_dict_type WHERE status = #{status} ORDER BY id
    </select>
    
    <select id="selectById" resultMap="DictTypeResult">
        SELECT * FROM t_dict_type WHERE id = #{id}
    </select>
    
    <select id="selectByDictType" resultMap="DictTypeResult">
        SELECT * FROM t_dict_type WHERE dict_type = #{dictType}
    </select>
    
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_dict_type (dict_name, dict_type, remark, status)
        VALUES (#{dictName}, #{dictType}, #{remark}, #{status})
    </insert>
    
    <update id="update">
        UPDATE t_dict_type
        <set>
            <if test="dictName != null">dict_name = #{dictName},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id}
    </update>
    
    <delete id="deleteById">
        DELETE FROM t_dict_type WHERE id = #{id}
    </delete>
    
    <select id="selectByKeyword" resultMap="DictTypeResult">
        SELECT * FROM t_dict_type 
        WHERE dict_name LIKE CONCAT('%', #{keyword}, '%')
           OR dict_type LIKE CONCAT('%', #{keyword}, '%')
           OR remark LIKE CONCAT('%', #{keyword}, '%')
        ORDER BY id
    </select>
    
</mapper>
