<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.miribar.ordering.mapper.RoleMapper">
    
    <resultMap id="RoleResult" type="com.miribar.ordering.entity.Role">
        <id property="id" column="id"/>
        <result property="roleName" column="role_name"/>
        <result property="roleCode" column="role_code"/>
        <result property="description" column="description"/>
        <result property="dataScope" column="data_scope"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>
    
    <select id="selectAll" resultMap="RoleResult">
        SELECT * FROM t_role ORDER BY id
    </select>
    
    <select id="selectByStatus" resultMap="RoleResult">
        SELECT * FROM t_role WHERE status = #{status} ORDER BY id
    </select>
    
    <select id="selectById" resultMap="RoleResult">
        SELECT * FROM t_role WHERE id = #{id}
    </select>
    
    <select id="selectByRoleCode" resultMap="RoleResult">
        SELECT * FROM t_role WHERE role_code = #{roleCode}
    </select>
    
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_role (role_name, role_code, description, data_scope, status)
        VALUES (#{roleName}, #{roleCode}, #{description}, #{dataScope}, #{status})
    </insert>
    
    <update id="update">
        UPDATE t_role
        <set>
            <if test="roleName != null">role_name = #{roleName},</if>
            <if test="roleCode != null">role_code = #{roleCode},</if>
            <if test="description != null">description = #{description},</if>
            <if test="dataScope != null">data_scope = #{dataScope},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id}
    </update>
    
    <delete id="deleteById">
        DELETE FROM t_role WHERE id = #{id}
    </delete>
    
    <select id="selectRolesByStaffId" resultMap="RoleResult">
        SELECT r.* 
        FROM t_role r
        INNER JOIN t_staff_role sr ON r.id = sr.role_id
        WHERE sr.staff_id = #{staffId}
        ORDER BY r.id
    </select>
    
</mapper>
