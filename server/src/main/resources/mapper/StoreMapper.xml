<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.miribar.ordering.mapper.StoreMapper">

    <select id="selectById" resultType="Store">
        SELECT * FROM t_store WHERE id = #{id}
    </select>

    <select id="selectIdByOrgId" resultType="java.lang.Long">
        SELECT id FROM t_store WHERE org_id = #{orgId} ORDER BY id LIMIT 1
    </select>

    <select id="selectFirstId" resultType="java.lang.Long">
        SELECT id FROM t_store ORDER BY id LIMIT 1
    </select>

</mapper>
