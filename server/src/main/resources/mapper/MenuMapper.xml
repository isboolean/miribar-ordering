<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.miribar.ordering.mapper.MenuMapper">
    
    <resultMap id="MenuResult" type="com.miribar.ordering.entity.Menu">
        <id property="id" column="id"/>
        <result property="parentId" column="parent_id"/>
        <result property="menuType" column="menu_type"/>
        <result property="menuName" column="menu_name"/>
        <result property="path" column="path"/>
        <result property="component" column="component"/>
        <result property="permissionCode" column="permission_code"/>
        <result property="icon" column="icon"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="visible" column="visible"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>
    
    <select id="selectAll" resultMap="MenuResult">
        SELECT * FROM t_menu ORDER BY sort_order
    </select>
    
    <select id="selectByStatus" resultMap="MenuResult">
        SELECT * FROM t_menu WHERE status = #{status} ORDER BY sort_order
    </select>
    
    <select id="selectById" resultMap="MenuResult">
        SELECT * FROM t_menu WHERE id = #{id}
    </select>
    
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_menu (parent_id, menu_type, menu_name, path, component, permission_code, icon, sort_order, visible, status)
        VALUES (#{parentId}, #{menuType}, #{menuName}, #{path}, #{component}, #{permissionCode}, #{icon}, #{sortOrder}, #{visible}, #{status})
    </insert>
    
    <update id="update">
        UPDATE t_menu
        <set>
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="menuType != null">menu_type = #{menuType},</if>
            <if test="menuName != null">menu_name = #{menuName},</if>
            <if test="path != null">path = #{path},</if>
            <if test="component != null">component = #{component},</if>
            <if test="permissionCode != null">permission_code = #{permissionCode},</if>
            <if test="icon != null">icon = #{icon},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="visible != null">visible = #{visible},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id}
    </update>
    
    <delete id="deleteById">
        DELETE FROM t_menu WHERE id = #{id}
    </delete>
    
    <select id="selectByRoleIds" resultMap="MenuResult">
        SELECT DISTINCT m.* 
        FROM t_menu m
        INNER JOIN t_role_menu rm ON m.id = rm.menu_id
        WHERE rm.role_id IN
        <foreach collection="roleIds" item="roleId" open="(" separator="," close=")">
            #{roleId}
        </foreach>
        AND m.status = 1
        ORDER BY m.sort_order
    </select>
    
    <select id="selectMenusByRoleId" resultMap="MenuResult">
        SELECT m.* 
        FROM t_menu m
        INNER JOIN t_role_menu rm ON m.id = rm.menu_id
        WHERE rm.role_id = #{roleId}
        ORDER BY m.sort_order
    </select>
    
    <delete id="deleteMenusByRoleId">
        DELETE FROM t_role_menu WHERE role_id = #{roleId}
    </delete>
    
</mapper>
