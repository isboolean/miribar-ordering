.page {
  min-height: 100vh;
  background: var(--color-primary-dark);
  display: flex;
  flex-direction: column;
}

.hero {
  padding: 140rpx 48rpx 80rpx;
  color: #fff;
}
.hero-title {
  font-size: 72rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}
.hero-sub {
  margin-top: 16rpx;
  font-size: 28rpx;
  opacity: 0.7;
}

.body {
  flex: 1;
  background: var(--color-bg);
  border-radius: 40rpx 40rpx 0 0;
  padding: 48rpx 40rpx;
}
.center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx;
  margin-bottom: 32rpx;
}
.error-icon { font-size: 48rpx; margin-bottom: 12rpx; }
.error-text { color: var(--color-danger); font-size: 26rpx; text-align: center; }

.scan-btn {
  height: 104rpx;
  line-height: 104rpx;
  font-size: 34rpx;
}

.resume {
  margin-top: 28rpx;
  text-align: center;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  text-decoration: underline;
}

.tips {
  margin-top: 64rpx;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-card);
}
.tips-title {
  font-weight: 700;
  margin-bottom: 16rpx;
}
.tips-item {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 44rpx;
}

.loading-dot {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #ddd;
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.loading-text { margin-top: 24rpx; color: var(--color-text-secondary); }
.ok-text { font-size: 32rpx; font-weight: 600; margin-bottom: 16rpx; }

.compliance {
  padding: 24rpx 0 calc(24rpx + env(safe-area-inset-bottom));
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg);
}
