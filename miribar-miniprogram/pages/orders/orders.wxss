.page {
  padding: 24rpx 24rpx 48rpx;
}

.table-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
}
.tb-table { font-size: 32rpx; font-weight: 700; }
.tb-bill { margin-top: 8rpx; font-size: 24rpx; color: var(--color-text-secondary); }
.add-btn { width: 160rpx; }

.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  color: var(--color-text-secondary);
  padding: 120rpx 0;
}

.orders { display: flex; flex-direction: column; gap: 20rpx; }

.order { padding: 28rpx 32rpx; }
.order.highlight { border: 2rpx solid var(--color-primary); }
.order-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.order-no { font-size: 26rpx; color: var(--color-text-secondary); }
.order-status { font-size: 26rpx; font-weight: 700; }
.order-time { font-size: 22rpx; color: #c0c0c4; margin-top: 4rpx; }

/* 状态色 */
.st-pending { color: var(--color-warning); }
.st-making  { color: #1989fa; }
.st-done    { color: var(--color-success); }
.st-reject  { color: var(--color-danger); }
.st-cancel  { color: var(--color-text-secondary); }

.order-items { margin-top: 16rpx; }
.order-item-line {
  font-size: 26rpx;
  line-height: 44rpx;
  color: var(--color-text);
}
.order-remark {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  background: #f6f6f8;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
}
.order-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
}
.cancel-btn {
  background: #fff;
  border: 2rpx solid #dcdce0;
  color: var(--color-text-secondary);
  border-radius: 999rpx;
}

.poll-tip {
  text-align: center;
  font-size: 22rpx;
  color: #c8c8cc;
  margin-top: 32rpx;
}
