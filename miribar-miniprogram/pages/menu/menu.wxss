.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.store-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 32rpx;
  background: var(--color-card);
  box-shadow: var(--shadow-card);
  z-index: 5;
}
.store-name { font-size: 32rpx; font-weight: 700; }
.table-no {
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  background: #fff1ec;
  color: var(--color-primary);
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
}
.orders-link { color: var(--color-text-secondary); font-size: 26rpx; }

.state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--color-text-secondary);
  gap: 24rpx;
}
.retry { margin-top: 8rpx; }

.main {
  flex: 1;
  display: flex;
  overflow: hidden;
}

/* 左侧分类 */
.side {
  width: 176rpx;
  background: #eeeef2;
  flex-shrink: 0;
}
.side-item {
  padding: 32rpx 16rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  text-align: center;
  position: relative;
}
.side-item.active {
  background: var(--color-bg);
  color: var(--color-primary);
  font-weight: 700;
}
.side-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 36rpx;
  background: var(--color-primary);
  border-radius: 0 6rpx 6rpx 0;
}

/* 右侧商品 */
.list { flex: 1; padding: 0 20rpx calc(140rpx + env(safe-area-inset-bottom)); }
.group-title {
  padding: 28rpx 8rpx 16rpx;
  font-size: 30rpx;
  font-weight: 700;
}
.product {
  display: flex;
  margin-bottom: 20rpx;
  padding: 20rpx;
}
.product-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-base);
  flex-shrink: 0;
}
.product-img.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0f0f4;
  font-size: 60rpx;
}
.product-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}
.product-name { font-size: 30rpx; font-weight: 600; }
.product-name .tag { margin-left: 8rpx; }
.product-desc {
  flex: 1;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.product-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}
.add-btn {
  width: 52rpx;
  height: 52rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
}
.add-btn.disabled { background: #ccc; }
.list-footer {
  text-align: center;
  padding: 24rpx 0;
  font-size: 22rpx;
  color: #c8c8cc;
}

/* 弹窗 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 20;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.sku-popup {
  width: 100%;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}
.sku-title { font-size: 34rpx; font-weight: 700; margin-bottom: 24rpx; }
.sku-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
}
.sku-item.disabled { color: #c0c0c4; }
.sku-soldout { font-size: 22rpx; color: var(--color-danger); margin-left: 12rpx; }
.sku-cancel {
  margin-top: 24rpx;
  text-align: center;
  color: var(--color-text-secondary);
  padding: 16rpx;
}

.cart-popup {
  width: 100%;
  background: var(--color-card);
  border-radius: 32rpx 32rpx 0 0;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}
.cart-head {
  display: flex;
  justify-content: space-between;
  padding: 32rpx;
  font-weight: 700;
}
.cart-clear { font-size: 26rpx; color: var(--color-text-secondary); font-weight: 400; }
.cart-list { max-height: 50vh; padding: 0 32rpx; }
.cart-item {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.cart-item-name { font-weight: 600; }
.cart-item-sku { font-size: 22rpx; color: var(--color-text-secondary); margin: 4rpx 0 8rpx; }
.cart-item-remark {
  font-size: 22rpx;
  background: #f6f6f8;
  border-radius: 8rpx;
  padding: 8rpx 12rpx;
}
.cart-item-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: space-between;
}

/* 底部购物车栏 */
.cart-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-primary-dark);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx;
  z-index: 15;
}
.cart-bar-left { display: flex; align-items: center; }
.cart-icon {
  position: relative;
  font-size: 44rpx;
  margin-right: 20rpx;
}
.cart-badge {
  position: absolute;
  top: -10rpx;
  right: -16rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 6rpx;
  background: var(--color-primary);
  color: #fff;
  border-radius: 999rpx;
  font-size: 20rpx;
  text-align: center;
}
.cart-amount { color: #fff; font-size: 36rpx; }
.checkout-btn {
  width: 220rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
}
.checkout-btn.disabled { background: #555; }
