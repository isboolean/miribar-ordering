<view class="page">
  <view class="head">
    <view class="head-title">会员登录</view>
    <view class="head-sub">登录后可累计积分、使用优惠券（不登录也可正常点餐）</view>
  </view>

  <view class="card form">
    <view class="field">
      <text class="field-label">手机号</text>
      <input type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" />
    </view>

    <view class="field">
      <text class="field-label">图形验证码</text>
      <input class="grow" placeholder="右侧图形验证码" value="{{captchaCode}}" bindinput="onCaptchaInput" />
      <image
        wx:if="{{captchaImage}}"
        class="captcha-img"
        src="{{captchaImage}}"
        bindtap="onCaptchaReload"
      />
      <text wx:else class="captcha-reload" bindtap="onCaptchaReload">点击加载</text>
    </view>

    <view class="field">
      <text class="field-label">短信验证码</text>
      <input class="grow" type="number" maxlength="6" placeholder="短信验证码" value="{{smsCode}}" bindinput="onSmsInput" />
      <button size="mini" class="sms-btn {{countdown > 0 ? 'disabled' : ''}}" disabled="{{countdown > 0}}" bindtap="onSendSms">
        {{countdown > 0 ? countdown + 's' : '发送验证码'}}
      </button>
    </view>

    <button class="submit btn-primary" disabled="{{submitting}}" bindtap="onSubmit">
      {{submitting ? '登录中…' : '登录'}}
    </button>

    <view class="agreement">
      登录即代表同意《用户隐私保护指引》，手机号仅用于订单关联与会员服务
    </view>
  </view>
</view>
