/* ================= 全局变量 ================= */
page {
  --color-primary: #ff6a3c;      /* 品牌主色（暖橙，酒吧氛围） */
  --color-primary-dark: #1f1f2e; /* 深色底 */
  --color-danger: #ee0a24;
  --color-warning: #ff976a;
  --color-success: #07c160;
  --color-text: #323233;
  --color-text-secondary: #969799;
  --color-bg: #f6f6f8;
  --color-card: #ffffff;
  --radius-base: 12rpx;
  --radius-lg: 20rpx;
  --shadow-card: 0 4rpx 16rpx rgba(31, 31, 46, 0.06);
}

page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 28rpx;
  color: var(--color-text);
  background-color: var(--color-bg);
  box-sizing: border-box;
}

view, text, image, button {
  box-sizing: border-box;
}

/* ================= 通用工具类 ================= */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.card {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.btn-primary {
  background: var(--color-primary);
  color: #fff;
  border-radius: 999rpx;
  font-weight: 600;
}
.btn-primary[disabled] {
  opacity: 0.5;
}

.price {
  color: var(--color-primary);
  font-weight: 700;
}

.tag {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  line-height: 32rpx;
}
.tag-hot { background: #fff1ec; color: var(--color-primary); }
.tag-new { background: #e8f7ff; color: #1989fa; }

/* 售罄置灰 */
.sold-out {
  filter: grayscale(1);
  opacity: 0.5;
}

/* 数量步进器 */
.stepper {
  display: flex;
  align-items: center;
}
.stepper-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  border: 2rpx solid var(--color-primary);
  color: var(--color-primary);
  font-size: 32rpx;
}
.stepper-btn.minus {
  border-color: var(--color-text-secondary);
  color: var(--color-text-secondary);
}
.stepper-num {
  min-width: 56rpx;
  text-align: center;
  font-weight: 600;
}
